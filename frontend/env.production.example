# Salin menjadi .env.production di folder frontend (sebelum `npm run build`).
# Satu domain dengan reverse proxy: API ada di /api/v1, WebSocket di /ws (otomatis wss://).
NEXT_PUBLIC_API_URL=https://helpdesk.contoh-rs.id/api/v1

# Nama instansi di kop dokumen cetak (BAST tiket & Laporan KPI).
# NEXT_PUBLIC_* tertanam SAAT build — ulangi `npm run build` kalau nilainya berubah.
NEXT_PUBLIC_INSTITUTION_NAME=Rumah Sakit — Unit IT / SIMRS
