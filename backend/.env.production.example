# ---- PRODUCTION (simpan sebagai .env di folder yang sama dengan ticketing-api.exe) ----
# Isi nilai asli HANYA di server. Jangan di-commit, jangan dikirim lewat chat/email.

# Mengaktifkan pemeriksaan keamanan saat start: aplikasi menolak jalan kalau
# JWT_SECRET masih default / terlalu pendek, atau CORS masih ke localhost.
APP_ENV=production

# Di belakang reverse proxy pada mesin yang sama: dengarkan hanya localhost,
# sehingga backend tidak bisa dijangkau langsung dari jaringan.
APP_HOST=127.0.0.1
APP_PORT=8080

# Wajib diisi. Pakai user database khusus aplikasi (hak minimum, bukan superuser).
# Database & aplikasi di mesin yang sama -> sslmode=disable boleh; beda mesin -> sslmode=require.
DATABASE_URL=postgres://ticketing_user:PASSWORD_KUAT@127.0.0.1:5432/ticketing_it?sslmode=disable

# Akun READ-ONLY khusus aplikasi ini (lihat deploy/simrs-readonly.sql).
# Kosongkan untuk menonaktifkan modul Monitoring.
SIMRS_DATABASE_URL=postgres://ticketing_ro:PASSWORD_KUAT@IP_SIMRS:PORT/NAMA_DB?sslmode=require

# Minimal 32 karakter acak. Buat dengan (PowerShell):
#   $b = New-Object byte[] 48; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
JWT_SECRET=GANTI_DENGAN_STRING_ACAK_PANJANG

# Alamat frontend yang sebenarnya (HTTPS), pisahkan dengan koma kalau lebih dari satu.
CORS_ALLOWED_ORIGINS=https://helpdesk.contoh-rs.id

# Akun dibuat leader/admin lewat Manajemen User, bukan daftar mandiri.
ALLOW_PUBLIC_REGISTRATION=false

SLA_CHECK_MINUTES=5
