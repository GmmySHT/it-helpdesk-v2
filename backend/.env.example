# ---- Development (salin jadi .env, JANGAN di-commit) ----
APP_ENV=development
APP_HOST=
APP_PORT=8080

DATABASE_URL=postgres://ticketing_user:GANTI_PASSWORD@localhost:5432/ticketing_it?sslmode=disable

# Kosongkan kalau tidak perlu modul Monitoring (aplikasi tetap jalan tanpa SIMRS)
SIMRS_DATABASE_URL=

# Di development boleh dibiarkan, tapi akan muncul peringatan.
JWT_SECRET=change-me-in-production

CORS_ALLOWED_ORIGINS=http://localhost:3000
ALLOW_PUBLIC_REGISTRATION=false
SLA_CHECK_MINUTES=5
